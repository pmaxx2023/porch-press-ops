{% comment %}
  Porch Press TV — homepage episode player (canvas + shoppable hotspots).
  Cart uses native /cart/VARIANT:qty permalinks. Products may be archived.
{% endcomment %}

<style id="pp-tv-chrome-hide">
  .shopify-section-group-header-group,
  .shopify-section-group-footer-group,
  .header-wrapper,
  sticky-header,
  .announcement-bar,
  .section-header,
  .footer,
  #shopify-section-footer {
    display: none !important;
  }
  body { margin: 0 !important; }
  #MainContent { padding: 0 !important; margin: 0 !important; max-width: none !important; }
  .pp-tv-root { isolation: isolate; }
</style>

<div class="pp-tv-root">
<title>Porch Press TV</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Libre+Franklin:wght@400;500;600;700;800;900&family=Special+Elite&display=swap">
<style>
:root{
  --bg:#F2EBDD;
  --paper:#FBF7EF;
  --ink:#1C2231;
  --ink-2:#4A5063;
  --ink-3:#7C8092;
  --red:#A3302A;
  --red-deep:#7E221D;
  --gold:#B8914A;
  --manila:#E9D8B4;
  --line:#DDD1BB;
  --stage:#0F131C;
  --soon:#3A5A8C;
  --soon-deep:#2C4670;
  --ok:#3F6B3A;
  --f-display:"Libre Baskerville",Georgia,"Times New Roman",serif;
  --f-ui:"Libre Franklin",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-type:"Special Elite","Courier New",monospace;
  --f-hand:Caveat,"Segoe Print","Bradley Hand",cursive;
  color-scheme:light;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{background:var(--bg)}
body{
  margin:0;min-height:100%;
  background:
    radial-gradient(880px 560px at 6% -14%, #FFF4DA 0%, rgba(255,244,218,0) 64%),
    radial-gradient(700px 520px at 104% -6%, #E6E0D2 0%, rgba(230,224,210,0) 60%),
    var(--bg);
  color:var(--ink);
  font:16px/1.55 var(--f-ui);
  padding-inline:16px;padding-block:0 56px;
}
button{font:inherit;color:inherit}
a{color:inherit}
.wrap{max-width:1120px;margin:0 auto}

/* header */
.top{display:flex;align-items:center;gap:12px;padding-block:16px 12px}
.brand{display:flex;align-items:baseline;gap:10px;text-decoration:none;min-width:0}
.brand b{font-family:var(--f-display);font-weight:700;font-size:24px;letter-spacing:-.01em;color:var(--ink);white-space:nowrap}
.brand small{font-family:var(--f-display);font-style:italic;font-size:14px;color:var(--ink-2);white-space:nowrap}
.tv{font-family:var(--f-type);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--red);padding:4px 10px;border:1.5px dashed var(--red);border-radius:4px;white-space:nowrap;transform:rotate(-2deg)}
.top .sp{flex:1}
.bagbtn{display:inline-flex;align-items:center;gap:8px;border:0;background:var(--paper);border-radius:99px;padding:8px 12px;font-weight:700;cursor:pointer;box-shadow:0 1px 0 var(--line),0 8px 20px -14px rgba(28,34,49,.6)}
.bagbtn svg{width:18px;height:18px}
.bagbtn:focus-visible,.qadd:focus-visible,.jump:focus-visible,.add:focus-visible,.ghost:focus-visible,.checkout:focus-visible,.ep-btn:focus-visible{outline:3px solid var(--red);outline-offset:2px}
.count{min-width:22px;height:22px;border-radius:99px;background:var(--red);color:#fff;font-size:12px;font-weight:800;display:inline-grid;place-items:center;padding:0 6px;font-variant-numeric:tabular-nums;line-height:1}
@media (max-width:620px){.brand small{display:none}}
@media (max-width:460px){.tv{display:none}.brand b{font-size:21px}}

/* layout */
.stage{display:grid;grid-template-columns:auto minmax(300px,420px);gap:40px;justify-content:center;align-items:start;padding-top:4px}
.pcol{display:flex;justify-content:center;min-width:0}
@media (max-width:900px){.stage{grid-template-columns:minmax(0,1fr);gap:26px}}

/* player */
.player{
  position:relative;aspect-ratio:9/16;
  width:calc(min(84vh, 880px) * .5625);
  border-radius:26px;overflow:hidden;background:var(--stage);
  box-shadow:0 0 0 6px var(--paper),0 0 0 7px var(--line),0 44px 80px -40px rgba(28,34,49,.75);
  user-select:none;-webkit-user-select:none;touch-action:manipulation;outline:none;
  max-width:100%;
}
@supports (height:100svh){.player{width:calc(min(84svh, 880px) * .5625)}}
.player:focus-visible{box-shadow:0 0 0 6px var(--paper),0 0 0 10px var(--red)}
#cv{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:pointer}

.tags{position:absolute;inset:0;pointer-events:none;z-index:2}
.tag{position:absolute;left:0;top:0;width:30px;height:30px;padding:0;border:0;background:transparent;pointer-events:auto;cursor:pointer;will-change:transform}
.tag::before{content:"";position:absolute;inset:-1px;border-radius:50%;border:2px solid var(--paper);animation:ping 1.8s ease-out infinite;pointer-events:none}
.tag .dot{position:absolute;inset:0;border-radius:50%;background:var(--paper);display:grid;place-items:center;box-shadow:0 0 0 2.5px var(--red),0 4px 12px rgba(10,12,20,.45);transition:transform .2s,background .2s}
.tag .dot svg{width:15px;height:15px;color:var(--red)}
.tag .lbl{position:absolute;top:50%;left:37px;transform:translateY(-50%) scale(.88);transform-origin:left center;white-space:nowrap;background:var(--paper);color:var(--ink);font-weight:700;font-size:13.5px;line-height:1;padding:7px 10px;border-radius:99px;box-shadow:0 6px 16px rgba(10,12,20,.35);opacity:0;pointer-events:none;transition:opacity .2s,transform .2s}
.tag .lbl b{color:var(--red);font-weight:800;margin-left:6px}
.tag.flip .lbl{left:auto;right:37px;transform-origin:right center}
.tag.focus .lbl,.tag:hover .lbl,.tag:focus-visible .lbl{opacity:1;transform:translateY(-50%) scale(1)}
.tag:hover .dot{transform:scale(1.12)}
.tag:focus-visible{outline:none}
.tag:focus-visible .dot{box-shadow:0 0 0 3px var(--paper),0 0 0 6px var(--red)}
.tags.wide .tag .dot{transform:scale(.74)}
.tags.wide .tag:hover .dot{transform:scale(.9)}
.tag.on .dot{background:var(--red)}
.tag.on .dot svg{color:var(--paper)}
.tag.soon .dot{box-shadow:0 0 0 2.5px var(--soon),0 4px 12px rgba(10,12,20,.45)}
.tag.soon .dot svg{color:var(--soon)}
.tag.soon .lbl b{color:var(--soon)}
.tag.soon.on .dot{background:var(--soon)}
@keyframes ping{0%{transform:scale(1);opacity:.9}100%{transform:scale(2.05);opacity:0}}

.ptop{position:absolute;top:12px;left:12px;right:12px;display:flex;justify-content:space-between;align-items:center;z-index:4;pointer-events:none}
.ptop > *{pointer-events:auto}
.epi{font-family:var(--f-type);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--paper);background:rgba(10,12,20,.5);padding:7px 11px;border-radius:99px;white-space:nowrap}
.pbag{position:relative;width:40px;height:40px;border-radius:50%;border:0;background:var(--paper);display:grid;place-items:center;cursor:pointer;box-shadow:0 6px 16px rgba(10,12,20,.4)}
.pbag svg{width:20px;height:20px;color:var(--ink)}
.pbag .count{position:absolute;top:-4px;right:-6px;min-width:20px;height:20px;font-size:11px;box-shadow:0 0 0 2px var(--paper)}
.pbag:focus-visible{outline:3px solid var(--paper);outline-offset:2px}
.bump{animation:bump .5s}
@keyframes bump{30%{transform:scale(1.28)}60%{transform:scale(.92)}}

.bigplay{position:absolute;left:50%;bottom:9.5%;transform:translateX(-50%);z-index:4;border:0;border-radius:99px;background:var(--paper);color:var(--ink);font-weight:800;font-size:16px;padding:10px 18px 10px 10px;display:flex;align-items:center;gap:10px;box-shadow:0 16px 34px -12px rgba(0,0,0,.7);cursor:pointer;white-space:nowrap}
.bigplay .pi{width:34px;height:34px;border-radius:50%;background:var(--red);display:grid;place-items:center}
.bigplay .pi svg{width:14px;height:14px;color:#fff;margin-left:2px}
.bigplay small{font-weight:700;color:var(--ink-3);font-size:13px}
.bigplay:hover .pi{background:var(--red-deep)}
.bigplay:focus-visible{outline:3px solid var(--paper);outline-offset:3px}

.ctrl{position:absolute;left:0;right:0;bottom:0;z-index:4;padding:0 12px 10px}
.bar{position:relative;height:24px;cursor:pointer;touch-action:none;outline:none}
.segs{position:absolute;left:0;right:0;top:10px;height:4px;display:flex;gap:3px;transition:height .15s,top .15s}
.bar:hover .segs,.bar:focus-visible .segs{height:6px;top:9px}
.seg{position:relative;height:100%;background:rgba(251,247,239,.3);border-radius:3px;overflow:hidden}
.seg i{position:absolute;left:0;top:0;bottom:0;width:0;background:var(--paper)}
.dots{position:absolute;left:0;right:0;top:3px;height:0;pointer-events:none}
.dots b{position:absolute;top:0;width:5px;height:5px;margin-left:-2.5px;border-radius:50%;background:#F3C7C1;box-shadow:0 0 0 1.5px var(--red)}
.knob{position:absolute;top:12px;left:0;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;background:var(--paper);box-shadow:0 2px 6px rgba(0,0,0,.45);pointer-events:none;transition:opacity .2s}
.bar:focus-visible .knob{box-shadow:0 0 0 3px var(--red)}
.row{display:flex;align-items:center;gap:4px;color:var(--paper);transition:opacity .3s}
.ib{flex:none;width:36px;height:36px;border:0;border-radius:50%;background:transparent;display:grid;place-items:center;cursor:pointer;color:var(--paper);padding:0}
.ib:hover{background:rgba(251,247,239,.16)}
.ib:focus-visible{outline:2px solid var(--paper);outline-offset:1px}
.ib svg{width:20px;height:20px}
.ib[aria-pressed="false"]{opacity:.5}
.time{flex:none;font-weight:700;font-size:13px;font-variant-numeric:tabular-nums;white-space:nowrap;margin-left:2px}
.chap{flex:1;min-width:0;font-size:13px;font-weight:500;opacity:.88;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-left:6px}
.player.idle .row,.player.idle .knob{opacity:0}
.player.idle .row{pointer-events:none}

.pop{position:absolute;z-index:6;width:min(310px, calc(100% - 16px));background:var(--paper);border-radius:16px;padding:12px;box-shadow:0 26px 56px -16px rgba(0,0,0,.75);color:var(--ink);animation:popin .24s cubic-bezier(.2,1.4,.4,1)}
@keyframes popin{from{opacity:0;transform:scale(.9)}}
.pop.sheet{left:8px!important;right:8px;width:auto;top:auto!important;bottom:62px}
.pop-grid{display:grid;grid-template-columns:76px minmax(0,1fr);gap:12px;padding-right:26px;align-items:center}
.pop-img{width:76px;height:76px;border-radius:8px;object-fit:cover;background:var(--manila);display:block;box-shadow:0 0 0 1px var(--line)}
.pick{display:flex;align-items:center;gap:6px;margin:0;font-family:var(--f-type);font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3)}
.pick img{width:20px;height:20px;border-radius:50%;flex:none}
.pop h3{margin:3px 0 2px;font-family:var(--f-display);font-size:16.5px;line-height:1.2;font-weight:700;text-wrap:balance}
.pop .price{font-weight:800;font-size:15px;margin:2px 0 0;font-variant-numeric:tabular-nums}
.pop .blurb{margin:10px 0 0;font-size:14.5px;line-height:1.4;color:var(--ink-2)}
.contents{margin:8px 0 0;font-size:13px;font-weight:600;color:var(--ink-3);line-height:1.35}
.add{width:100%;margin-top:12px;border:0;border-radius:10px;background:var(--red);color:#fff;font-weight:800;font-size:15px;padding:12px;cursor:pointer;display:block;text-align:center;text-decoration:none}
.add:hover{background:var(--red-deep)}
.add.soonbtn{background:var(--soon)}
.add.soonbtn:hover{background:var(--soon-deep)}
.meta{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:9px;font-size:13px;color:var(--ink-3)}
.meta a{color:var(--ink-2);font-weight:700;white-space:nowrap}
.x{position:absolute;top:8px;right:8px;width:28px;height:28px;border-radius:50%;border:0;background:var(--bg);display:grid;place-items:center;cursor:pointer;padding:0}
.x svg{width:14px;height:14px}
.x:focus-visible{outline:2px solid var(--red)}

.toast{position:absolute;top:62px;left:0;right:0;margin-inline:auto;width:max-content;z-index:10;max-width:calc(100% - 20px);background:var(--ink);color:var(--paper);border-radius:99px;padding:7px 7px 7px 14px;display:flex;align-items:center;gap:10px;font-weight:700;font-size:13px;box-shadow:0 14px 30px -10px rgba(0,0,0,.6);animation:tin .25s ease-out}
.toast span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.toast button{flex:none;border:0;background:var(--paper);color:var(--ink);border-radius:99px;padding:5px 11px;font-weight:800;font-size:12px;cursor:pointer}
@keyframes tin{from{opacity:0;transform:translateY(-8px)}}

.loading{position:absolute;inset:0;z-index:9;display:grid;place-items:center;background:var(--stage);color:var(--manila);font-family:var(--f-type);text-align:center;padding:24px}

.fly{position:fixed;width:46px;height:46px;border-radius:8px;object-fit:cover;z-index:40;box-shadow:0 0 0 3px var(--paper),0 8px 20px rgba(0,0,0,.35);pointer-events:none}

/* shop panel */
.shop{padding-top:6px;min-width:0}
.eyebrow{margin:0;font-family:var(--f-type);font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--red)}
.shop h1{margin:6px 0 12px;font-family:var(--f-display);font-weight:700;font-size:clamp(34px,4.6vw,46px);line-height:1.08;letter-spacing:-.015em;color:var(--ink);text-wrap:balance}
.logline{margin:0 0 12px;font-family:var(--f-display);font-style:italic;font-size:19px;color:var(--ink);line-height:1.35}
.logline span,.ep-line span{display:block;font-family:var(--f-type);font-style:normal;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:3px}
.lede{margin:0 0 22px;color:var(--ink-2);max-width:44ch;font-size:17px}
.shop h2{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin:0 0 12px;font-size:12.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
.shop h2 span{letter-spacing:0;text-transform:none;font-weight:600;color:var(--ink-3);font-size:13px}
.list{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.item{position:relative;display:grid;grid-template-columns:62px minmax(0,1fr) auto;gap:14px;align-items:center;background:var(--paper);border-radius:12px;padding:10px 12px 10px 10px;box-shadow:0 1px 0 var(--line),0 10px 24px -20px rgba(28,34,49,.7);transition:box-shadow .25s}
.item.live{box-shadow:0 0 0 2px var(--red),0 12px 26px -16px rgba(28,34,49,.7)}
.thumb{position:relative;width:62px;height:62px}
.thumb .ph{width:62px;height:62px;border-radius:8px;object-fit:cover;background:var(--manila);display:block}
.thumb .av{position:absolute;right:-7px;bottom:-7px;width:28px;height:28px;border-radius:50%;box-shadow:0 0 0 2.5px var(--paper)}
.item h3{margin:1px 0 0;font-family:var(--f-display);font-size:16.5px;font-weight:700;line-height:1.25}
.hook{margin:3px 0 0;font-size:14px;color:var(--ink-3);line-height:1.3}
.act{display:flex;flex-direction:column;align-items:flex-end;gap:6px}
.jump{border:0;background:transparent;font-size:13.5px;font-weight:700;color:var(--ink-2);cursor:pointer;display:flex;align-items:center;gap:5px;padding:3px 4px;border-radius:8px;font-variant-numeric:tabular-nums}
.jump:hover{color:var(--red)}
.jump svg{width:9px;height:9px}
.qadd{border:0;border-radius:99px;background:var(--ink);color:var(--paper);font-weight:800;font-size:14px;padding:8px 13px;cursor:pointer;white-space:nowrap;font-variant-numeric:tabular-nums}
.qadd:hover{background:var(--red)}
.qadd.inbag{background:var(--bg);color:var(--ink-2);box-shadow:inset 0 0 0 1.5px var(--line)}
.onair{position:absolute;top:-9px;left:12px;display:none;align-items:center;gap:5px;background:var(--red);color:#fff;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:3px 8px;border-radius:99px}
.item.live .onair{display:flex}
.onair::before{content:"";width:6px;height:6px;border-radius:50%;background:#fff;animation:blink 1.1s infinite}
@keyframes blink{50%{opacity:.25}}
.facts{margin:18px 0 0;font-size:14.5px;color:var(--ink-3);max-width:44ch}

/* episode guide + cast */
.sec-head{display:flex;justify-content:space-between;align-items:baseline;gap:8px 16px;flex-wrap:wrap;margin:64px 0 6px;padding-top:18px;border-top:1.5px solid var(--line)}
.sec-head h2{margin:0;font-family:var(--f-display);font-weight:700;font-size:clamp(26px,3.4vw,34px);color:var(--ink);line-height:1.15;letter-spacing:-.01em}
.sec-head p{margin:0;color:var(--ink-2);font-size:15px}
.row-title{margin:22px 0 10px;font-family:var(--f-type);font-weight:400;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-2)}
.eps{list-style:none;margin:0 -16px;padding:4px 16px 16px;display:grid;grid-auto-flow:column;grid-auto-columns:minmax(220px,250px);gap:16px;overflow-x:auto;scroll-snap-type:x proximity}
.ep{scroll-snap-align:start;background:var(--paper);border-radius:14px;padding:10px 10px 14px;box-shadow:0 1px 0 var(--line),0 12px 26px -20px rgba(28,34,49,.7);display:flex;flex-direction:column;min-width:0}
.ep.now{box-shadow:0 0 0 2px var(--red),0 12px 26px -16px rgba(28,34,49,.7)}
.ep-art{position:relative;aspect-ratio:4/3;border-radius:8px;overflow:hidden;background:var(--stage)}
.ep-art img,.ep-art canvas{width:100%;height:100%;object-fit:cover;display:block}
.badge{position:absolute;top:8px;left:8px;background:var(--red);color:#fff;font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:4px 8px;border-radius:99px}
.badge.soft{background:var(--paper);color:var(--ink)}
.badge.soon{background:var(--soon);color:#fff}
.ep-no{margin:12px 2px 0;font-family:var(--f-type);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3)}
.ep h3{margin:2px 2px 4px;font-family:var(--f-display);font-size:17px;font-weight:700;line-height:1.25}
.ep-line{margin:0 2px 12px;font-size:15px;color:var(--ink-2);flex:1}
.ep-btn{display:block;text-align:center;border:0;border-radius:10px;background:var(--red);color:#fff;font-weight:800;font-size:14px;padding:10px;cursor:pointer;text-decoration:none}
.ep-btn:hover{background:var(--red-deep)}
.ep-btn.quiet{background:var(--ink)}
.ep-btn.quiet:hover{background:var(--red)}
.ep-note{display:block;text-align:center;border-radius:10px;background:var(--bg);color:var(--ink-3);font-weight:700;font-size:13.5px;padding:10px}
.cast{list-style:none;margin:14px 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px}
.cm{background:var(--paper);border-radius:14px;padding:10px 10px 14px;box-shadow:0 1px 0 var(--line),0 12px 26px -20px rgba(28,34,49,.7)}
.cm img{width:100%;aspect-ratio:1;border-radius:8px;object-fit:cover;display:block}
.cm h3{margin:10px 2px 0;font-family:var(--f-display);font-size:18px;font-weight:700}
.cm-role{margin:0 2px;font-family:var(--f-type);font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--red)}
.cm-bio{margin:4px 2px 0;font-size:15px;color:var(--ink-2)}

/* find your case */
.quiz{position:absolute;inset:0;z-index:8;display:flex;flex-direction:column;padding:62px 18px 16px;overflow:auto;background:radial-gradient(120% 80% at 50% 0%,#FFF8EA 0%,#F2EBDD 55%,#E4D8C0 100%);animation:popin .25s cubic-bezier(.2,1.2,.4,1)}
.quiz .qx{position:absolute;top:12px;right:12px;width:36px;height:36px;background:var(--paper);box-shadow:0 4px 12px rgba(28,34,49,.2)}
.q-top{display:flex;align-items:center;justify-content:space-between;gap:10px}
.q-step{margin:0;font-family:var(--f-type);font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--red)}
.q-dots{display:flex;gap:6px}
.q-dots i{width:22px;height:6px;border-radius:3px;background:rgba(163,48,42,.2)}
.q-dots i.on{background:var(--red)}
.q-h{margin:14px 0 16px;font-family:var(--f-display);font-weight:700;font-size:25px;line-height:1.2;color:var(--ink);text-wrap:balance}
.q-opts{display:grid;gap:10px}
.q-opt{display:flex;align-items:center;gap:12px;width:100%;text-align:left;border:0;background:var(--paper);border-radius:12px;padding:12px 14px;min-height:60px;font-weight:700;font-size:17px;line-height:1.3;color:var(--ink);cursor:pointer;box-shadow:0 1px 0 var(--line),0 10px 22px -16px rgba(28,34,49,.7);transition:box-shadow .15s,transform .15s}
