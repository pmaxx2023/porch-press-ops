  now.querySelector('.ep-btn').addEventListener('click', () => { closePop(false); seek(0); play(); player.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' }); });
  s1.appendChild(now);
  GUIDE.forEach(g => {
    const pr = P[g.p], li = document.createElement('li'); li.className = 'ep';
    li.innerHTML = `<div class="ep-art"><img src="${pr.img}" alt="${pr.name} case art"><span class="badge soft">Episode coming</span></div>
      <p class="ep-no">${g.code}</p><h3>${pr.name}</h3><p class="ep-line"><span>In this episode</span>${g.log}</p>
      <a class="ep-btn quiet" href="${pdpUrl(g.p)}" target="_blank" rel="noopener">See the case · ${priceLabel(g.p)}</a>`;
    s1.appendChild(li);
  });
  const soon = $('#soonRow');
  Object.keys(SOON).forEach(key => {
    const s = SOON[key], li = document.createElement('li'); li.className = 'ep';
    li.innerHTML = `<div class="ep-art"><canvas width="320" height="240" aria-hidden="true"></canvas><span class="badge soon">Coming soon</span></div>
      <p class="ep-no">Porch Press mystery</p><h3>${s.title}</h3><p class="ep-line"><span>${s.tagline}</span>${s.desc}</p>
