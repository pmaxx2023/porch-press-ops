}

/* ---------- find your case ---------- */
const IC = {
  a: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6.5L20.5 7"/></svg>',
  b: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v16M5 20h14M4 8h16"/><path d="M6.5 8 4 14a3 3 0 0 0 5 0zM17.5 8 15 14a3 3 0 0 0 5 0z"/></svg>',
  c: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M4 17 3 7l5 4 4-6 4 6 5-4-1 10z"/><path d="M4 20h16"/></svg>',
};
const QUIZ = {
  q1: [
    { t: 'A family secret', k: 'a' },
    { t: 'A fight over paper', k: 'b' },
    { t: 'Old stones and old crowns', k: 'c' },
  ],
  q2: {
    a: [{ t: 'Who was she before Sutton?', p: 'baby' }, { t: 'Why is Eleanor missing from the family story?', p: 'eleanor' }],
    b: [{ t: 'Two widows. Which claim holds?', p: 'widow' }, { t: 'Three claims. Who gets the keys?', p: 'inheritance' }],
    c: [{ t: 'Who is really buried here?', p: 'roscoe' }, { t: 'Who comes before him in line?', p: 'king' }],
  },
};
const quizEl = $('#quiz'), quizBody = $('#quizBody');
let quizState = null, quizResume = false;
function quizHead(step) {
  return `<div class="q-top"><p class="q-step">Find your case · ${step} of 2</p><div class="q-dots" aria-hidden="true">${[1, 2].map(i => `<i class="${i <= step ? 'on' : ''}"></i>`).join('')}</div></div>`;
}
function renderQuiz() {
  const q = quizState;
  let h = '';
  if (q.step === 1) {
    h = quizHead(1) + `<h2 class="q-h">What kind of mystery tonight?</h2><div class="q-opts">${QUIZ.q1.map(o => `<button class="q-opt" type="button" data-k="${o.k}"><span class="q-ic">${IC[o.k]}</span>${o.t}</button>`).join('')}</div>`;
  } else if (q.step === 2) {
    h = quizHead(2) + `<h2 class="q-h">Which question keeps you up at night?</h2><div class="q-opts">${QUIZ.q2[q.a].map(o => `<button class="q-opt" type="button" data-p="${o.p}"><img src="${AV[P[o.p].who]}" alt="">${o.t}</button>`).join('')}</div><button class="q-back" type="button">← Back</button>`;
  } else {
    const pr = P[q.p], who = pr.who, has = inBag(q.p);
    h = `<div class="q-res"><p class="q-step">Your case</p>
      <img class="q-pic" src="${pr.img}" alt="${pr.name} case art">
      <h2>Open ${pr.name}</h2>
      <p class="q-twin"><img src="${AV[who]}" alt="">Same pick as ${CLUB[who].name}</p>
      <p class="blurb">${pr.blurb}</p>
      <p class="contents">${pr.contents}</p>
      <p class="price">${priceLabel(p)}</p>
      <button class="add" type="button" id="quizAdd">${has ? 'In your bag · View bag' : `Add ${pr.name} to bag`}</button>
      <div class="q-links"><button type="button" id="quizRetake">Retake</button><button type="button" id="quizWatch">${t >= DUR - .05 ? 'Watch again' : 'Keep watching'}</button></div></div>`;
  }
  quizBody.innerHTML = h;
  quizBody.querySelectorAll('.q-opt').forEach(b => b.addEventListener('click', () => {
    if (b.dataset.k) { q.a = b.dataset.k; q.step = 2; }
    else if (b.dataset.p) { q.p = b.dataset.p; q.step = 3; Snd.sfx('sparkle'); }
    renderQuiz();
  }));
  const back = quizBody.querySelector('.q-back'); if (back) back.addEventListener('click', () => { q.step -= 1; renderQuiz(); });
  const add = $('#quizAdd'); if (add) add.addEventListener('click', () => { if (inBag(q.p)) { openBag(); return; } addToBag(q.p, add); add.textContent = 'In your bag · View bag'; });
  const re = $('#quizRetake'); if (re) re.addEventListener('click', () => { quizState = { step: 1 }; renderQuiz(); });
  const w = $('#quizWatch'); if (w) w.addEventListener('click', () => { const again = t >= DUR - .05; closeQuiz(false); if (again) { seek(0); play(); } else play(); });
  requestAnimationFrame(() => { const f = quizBody.querySelector('.q-opt, #quizAdd'); if (f) f.focus({ preventScroll: true }); });
}
function openQuiz() {
  closePop(false);
  quizResume = playing && t < DUR - .05;
  if (playing) pause();
  quizState = { step: 1 };
  renderQuiz(); quizEl.hidden = false;
}
function closeQuiz(resume) {
  if (quizEl.hidden) return;
  quizEl.hidden = true;
  if (resume && quizResume) play();
  quizResume = false; player.focus({ preventScroll: true });
}
$('#quizClose').addEventListener('click', () => closeQuiz(true));
$('#findBtn').addEventListener('click', () => {
  openQuiz();
  const r = player.getBoundingClientRect(); if (r.top < 0 || r.bottom > innerHeight) player.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
});

/* ---------- sound ---------- */
const mtof = m => 440 * Math.pow(2, (m - 69) / 12);
const PROG = [
  { bass: 45, keys: [55, 59, 60, 64] },
  { bass: 41, keys: [52, 55, 57, 60] },
  { bass: 38, keys: [53, 57, 60, 64] },
  { bass: 40, keys: [50, 56, 59, 65] },
];
const MEL = { 8: 76, 24: 74, 30: 72, 40: 71, 56: 69 };
const ARP = [0, 2, 1, 3, 2, 1, 3, 2];
const Snd = {
  ac: null, on: true, master: null, bus: null, duck: null, drums: null, noise: null, crackleBuf: null, crk: null, timer: null, next: 0, step: 0,
  init() {
    if (this.ac) return true;
    const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return false;
    try { this.ac = new AC(); } catch (e) { return false; }
    const ac = this.ac;
    this.master = ac.createGain(); this.master.gain.value = this.on ? 1.1 : 0; this.master.connect(ac.destination);
    const warm = ac.createBiquadFilter(); warm.type = 'lowpass'; warm.frequency.value = 3400; warm.Q.value = .5; warm.connect(this.master);
    this.duck = ac.createGain(); this.duck.connect(warm);
    this.bus = ac.createGain(); this.bus.gain.value = .7; this.bus.connect(this.duck);
    const dlp = ac.createBiquadFilter(); dlp.type = 'lowpass'; dlp.frequency.value = 11000; dlp.connect(this.master);
    this.drums = ac.createGain(); this.drums.gain.value = .56; this.drums.connect(dlp);
    const n = ac.sampleRate * 2, nb = ac.createBuffer(1, n, ac.sampleRate), nd = nb.getChannelData(0);
    for (let i = 0; i < n; i++) nd[i] = Math.random() * 2 - 1;
    this.noise = nb;
    const cl = ac.sampleRate * 4, cb = ac.createBuffer(1, cl, ac.sampleRate), cd = cb.getChannelData(0);
    let b0 = 0;
    for (let i = 0; i < cl; i++) {
      b0 = .96 * b0 + .04 * (Math.random() * 2 - 1); cd[i] += b0 * .6;
      if (Math.random() < .0004) { const a = (Math.random() * .7 + .3) * (Math.random() < .5 ? -1 : 1); for (let j = 0; j < 36 && i + j < cl; j++) cd[i + j] += a * Math.exp(-j / 5); }
    }
    this.crackleBuf = cb;
    return true;
  },
  start() {
    if (!this.init()) return;
    this.ac.resume();
    if (this.timer) return;
    const ac = this.ac;
    this.crk = ac.createBufferSource(); this.crk.buffer = this.crackleBuf; this.crk.loop = true;
    const hp = ac.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 1100;
    const cg = ac.createGain(); cg.gain.value = .045;
    this.crk.connect(hp); hp.connect(cg); cg.connect(this.master); this.crk.start();
    this.next = ac.currentTime + .08;
    this.timer = setInterval(() => this.sched(), 50);
  },
  stop() {
    if (this.timer) { clearInterval(this.timer); this.timer = null; }
    if (this.crk) { try { this.crk.stop(); } catch (e) { } this.crk = null; }
  },
  sched() {
    const sd = 60 / 66 / 4;
    while (this.next < this.ac.currentTime + .22) {
      const s = this.step, sw = (s % 2) ? sd * .08 : 0;
      this.play(s, this.next + sw);
      this.next += sd; this.step++;
    }
  },
  play(s, t) {
    const bar = Math.floor(s / 16) % 4, i = s % 16, ch = PROG[bar], loop = Math.floor(s / 64);
    const hum = () => (Math.random() - .5) * .012;
    if (i === 0) { this.chord(ch.keys, t + hum(), 3.3, .62); this.bass(ch.bass, t, 3.4, .85); }
    if (i === 0) this.kick(t, .55);
    if (i === 3) this.kick(t, .34);
    if (i % 2 === 0) this.pluck(mtof(ch.keys[ARP[(i / 2) % 8]] + 12), t + hum(), i === 0 ? 1 : .62);
    if (loop % 2 === 1 && MEL[s % 64]) this.bell(mtof(MEL[s % 64]), t + hum());
  },
  pluck(f, t, v) {
    const ac = this.ac, o = ac.createOscillator(), o2 = ac.createOscillator(), g = ac.createGain(), g2 = ac.createGain();
    o.type = 'sine'; o.frequency.value = f; o2.type = 'triangle'; o2.frequency.value = f * 2;
    g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(.065 * v, t + .004); g.gain.exponentialRampToValueAtTime(.0001, t + .95);
    g2.gain.value = .3;
    o.connect(g); o2.connect(g2); g2.connect(g); g.connect(this.bus);
    o.start(t); o2.start(t); o.stop(t + 1); o2.stop(t + 1);
  },
  ep(f, t, dur, vel) {
    const ac = this.ac, car = ac.createOscillator(), mod = ac.createOscillator(), mg = ac.createGain(), g = ac.createGain();
    const dt = (Math.random() - .5) * 12;
    car.type = 'sine'; mod.type = 'sine';
    car.frequency.value = f; mod.frequency.value = f;
    car.detune.setValueAtTime(dt, t); car.detune.linearRampToValueAtTime(dt + 5, t + dur + .8);
    mg.gain.setValueAtTime(f * 1.5 * vel, t); mg.gain.exponentialRampToValueAtTime(f * .12 + 1, t + .8);
    mod.connect(mg); mg.connect(car.frequency);
    g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(.11 * vel, t + .012);
    g.gain.setTargetAtTime(.055 * vel, t + .06, .4); g.gain.setTargetAtTime(.0001, t + dur, .28);
    car.connect(g); g.connect(this.bus);
    car.start(t); mod.start(t); car.stop(t + dur + 1.4); mod.stop(t + dur + 1.4);
  },
  chord(notes, t, dur, vel) { notes.forEach((m, k) => this.ep(mtof(m), t + k * .009, dur, vel * (k ? .82 : 1))); },
  bass(m, t, dur, vel) {
    const ac = this.ac, f = mtof(m), o = ac.createOscillator(), o2 = ac.createOscillator(), g = ac.createGain(), g2 = ac.createGain();
    o.type = 'sine'; o.frequency.value = f; o2.type = 'triangle'; o2.frequency.value = f * 2;
    g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(.15 * vel, t + .012); g.gain.setTargetAtTime(.09 * vel, t + .05, .25); g.gain.setTargetAtTime(.0001, t + dur, .09);
    g2.gain.value = .45;
    o.connect(g); o2.connect(g2); g2.connect(g); g.connect(this.bus);
    o.start(t); o2.start(t); o.stop(t + dur + .6); o2.stop(t + dur + .6);
  },
  kick(t, v) {
    const ac = this.ac, o = ac.createOscillator(), g = ac.createGain();
    o.type = 'sine'; o.frequency.setValueAtTime(92, t); o.frequency.exponentialRampToValueAtTime(40, t + .16);
    g.gain.setValueAtTime(.0001, t); g.gain.exponentialRampToValueAtTime(.4 * v, t + .008); g.gain.exponentialRampToValueAtTime(.0001, t + .45);
    o.connect(g); g.connect(this.drums); o.start(t); o.stop(t + .5);
    const d = this.duck.gain; d.cancelScheduledValues(t); d.setValueAtTime(.78, t); d.linearRampToValueAtTime(1, t + .35);
  },
  bell(f, t) {
    const ac = this.ac, o = ac.createOscillator(), o2 = ac.createOscillator(), g = ac.createGain(), g2 = ac.createGain();
    o.type = 'sine'; o.frequency.value = f; o2.type = 'sine'; o2.frequency.value = f * 3.01;
    g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(.05, t + .006); g.gain.exponentialRampToValueAtTime(.0001, t + 1.4);
    g2.gain.value = .16;
    o.connect(g); o2.connect(g2); g2.connect(g); g.connect(this.bus);
    o.start(t); o2.start(t); o.stop(t + 1.5); o2.stop(t + 1.5);
  },
  tone(type, f, t0, v, dur, dest, f2) {
    const o = this.ac.createOscillator(), g = this.ac.createGain(); o.type = type; o.frequency.setValueAtTime(f, t0);
    if (f2) o.frequency.exponentialRampToValueAtTime(f2, t0 + dur * .6);
    g.gain.setValueAtTime(0, t0); g.gain.linearRampToValueAtTime(v, t0 + .008); g.gain.exponentialRampToValueAtTime(.0001, t0 + dur);
    o.connect(g); g.connect(dest || this.master); o.start(t0); o.stop(t0 + dur + .05);
  },
  swish(t0, v) {
    const ac = this.ac, src = ac.createBufferSource(), bp = ac.createBiquadFilter(), g = ac.createGain();
    src.buffer = this.noise; bp.type = 'bandpass'; bp.Q.value = 1.2;
    bp.frequency.setValueAtTime(900, t0); bp.frequency.exponentialRampToValueAtTime(3800, t0 + .22);
    g.gain.setValueAtTime(.0001, t0); g.gain.exponentialRampToValueAtTime(v, t0 + .06); g.gain.exponentialRampToValueAtTime(.0001, t0 + .28);
    src.connect(bp); bp.connect(g); g.connect(this.master); src.start(t0, Math.random()); src.stop(t0 + .3);
  },
  sfx(kind) {
    if (!this.on || !this.init()) return; const n = this.ac.currentTime;
    if (kind === 'pop') this.tone('sine', 440, n, .07, .14, null, 620);
    if (kind === 'blip') this.tone('sine', 860, n, .045, .12, null, 1180);
    if (kind === 'tick') this.tone('square', 1900, n, .02, .04);
    if (kind === 'page') this.swish(n, .09);
    if (kind === 'sparkle') [1568, 2093, 2637].forEach((f, i) => this.tone('triangle', f, n + i * .05, .03, .3));
    if (kind === 'ding') { this.ac.resume(); this.tone('sine', 2093, n, .1, .7); this.tone('sine', 3136, n, .035, .45); }
  },
  setOn(v) { this.on = v; if (this.master) this.master.gain.setTargetAtTime(v ? 1.1 : 0, this.ac.currentTime, .02); },
};

/* ---------- sizing & boot ---------- */
function resize() {
  const r = player.getBoundingClientRect();
  cssW = r.width || 1; cssH = r.height || 1;
  const dpr = Math.min(2, window.devicePixelRatio || 1);
  bw = Math.max(1, Math.round(cssW * dpr)); bh = Math.max(1, Math.round(cssH * dpr));
  if (cv.width !== bw || cv.height !== bh) { cv.width = bw; cv.height = bh; }
  dirty = true;
  if (popState) positionPop();
}
new ResizeObserver(resize).observe(player);

const SRC = {
  hero: window.__PP_TV_ASSETS.hero,
  pew: window.__PP_TV_ASSETS.pew,
  census: window.__PP_TV_ASSETS.census,
  story: window.__PP_TV_ASSETS.story,
  wall: window.__PP_TV_ASSETS.wall
};
ORDER.forEach(p => { SRC['c_' + p] = P[p].img; });
function loadImg(src) { return new Promise((res, rej) => { const im = new Image(); im.onload = () => res(im); im.onerror = () => rej(new Error(src)); im.src = src; }); }
async function boot() {
  try {
    const entries = await Promise.all(Object.entries(SRC).map(async ([k, s]) => [k, await loadImg(s)]));
    entries.forEach(([k, im]) => { IM[k] = im; });
  } catch (e) { $('#loading').textContent = 'The case images did not load. Refresh the page to try again.'; return; }
  ['hero', 'pew', 'census', 'story', 'wall'].forEach(k => { BL[k] = makeBlur(IM[k]); });
  if (document.fonts && document.fonts.load) {
    const fl = [`italic 50px ${FD}`, `700 27px ${FD}`, `500 20px ${FU}`, `600 23px ${FU}`, `700 19px ${FU}`, `800 25px ${FU}`, `900 94px ${FU}`, `15px ${FT}`, `700 31px ${FH}`].map(f => document.fonts.load(f).catch(() => null));
    await Promise.race([Promise.all(fl), new Promise(r => setTimeout(r, 3500))]);
  }
  buildCameos();
  layoutChat(); layoutCredits(); buildList(); buildGuide(); buildCast(); renderBag(); resize();
  $('#loading').hidden = true; dirty = true;
  requestAnimationFrame(ts => { lastTs = ts; loop(ts); });
}
boot();
})();
</script>
