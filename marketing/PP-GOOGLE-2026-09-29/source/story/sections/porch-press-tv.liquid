}
function buildCast() {
  const ul = $('#cast');
  CAST.forEach(id => {
    const k = CLUB[id], li = document.createElement('li'); li.className = 'cm';
    let src = '';
    try { src = KF[id].base.toDataURL('image/jpeg', .9); } catch (e) { }
    li.innerHTML = `<img src="${src}" alt="Cameo portrait of ${k.name}"><h3>${k.name}</h3><p class="cm-role">${k.age} · ${k.role}</p><p class="cm-bio">${k.bio}</p>`;
    ul.appendChild(li);
